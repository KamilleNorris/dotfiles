{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/dotfiles/**)",
      "Read(~/.claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/dotfiles/ai/adapters/claude/settings.json)"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "enabledPlugins": {
    "agent-browser@agent-browser": false,
    "agent-ready@dgalarza-workflows": false,
    "claude-code-setup@claude-plugins-official": true,
    "claudit@quickstop": true,
    "code-review@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "codebase-readiness@dgalarza-workflows": false,
    "frontend-design@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "worktrunk@worktrunk": true,
    "writing-for-humans@quickstop": true
  },
  "extraKnownMarketplaces": {
    "agent-browser": {
      "source": {
        "source": "git",
        "url": "https://github.com/vercel-labs/agent-browser.git"
      }
    },
    "dgalarza-workflows": {
      "source": {
        "source": "github",
        "repo": "dgalarza/claude-code-workflows"
      },
      "autoUpdate": false
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "quickstop": {
      "source": {
        "source": "github",
        "repo": "acoz-labs/quickstop"
      },
      "autoUpdate": true
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/ai/hooks/require-agent-comment-prefix.sh"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Atlassian__addCommentToJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/ai/hooks/require-agent-comment-prefix.sh"
          }
        ]
      }
    ]
  }
}
